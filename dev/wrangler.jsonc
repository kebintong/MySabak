// Cloudflare Worker for the mysabak demo. Deployed by GitHub Actions (.github/workflows/ci-cd.yml):
//   npx wrangler deploy --config dev/wrangler.jsonc
// Locally: npx wrangler dev --config dev/wrangler.jsonc (see README.md)
// The TomTom key is NOT here: it's the TOMTOM_KEY secret on the Worker (see README.md).
{
  "$schema": "https://unpkg.com/wrangler@4.149.0/config-schema.json",
  "name": "mysabak",
  "main": "worker.js",
  // Rebuilds dist/ before deploying, and during `dev` when these change
  "build": { "command": "node dev/build.mjs", "watch_dir": ["index.html", "manifest.webmanifest", "sw.js", "pages", "assets", "css", "js"] },
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "../dist", // built by build.mjs
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/html", "/html/*"]
  },
  // Keep variables set in the dashboard when GitHub Actions deploys (otherwise a deploy deletes them).
  // TOMTOM_KEY should still be type "Secret": secrets are always kept and their value is hidden.
  "keep_vars": true,
  "observability": { "enabled": true }
}
